# ---- Claude Code Game Kit ----
# ---- Universal ignores (engine-specific ones are appended below by the scaffolder) ----
# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp

# Secrets and local config (never commit)
.env
.env.*
secrets/
*.pem
*.key
*.keystore
*.pfx
*.p12
*.jks
*.p8

# Python tooling
__pycache__/
*.pyc

# Downloaded asset packs (tools/fetch_asset.py keeps them here; only picked files enter assets/)
.asset_cache/
.venv/

# Claude Code local-only files
.claude/settings.local.json
CLAUDE.local.md

# Scratch
scratch/
*.log
*.tmp

# ---- Godot 4 ----
.godot/
*.translation
export_credentials.cfg
/build/
/android/
.mono/
mono_crash.*.json

# Local AI (tools/setup_ai.py downloads these; too big for git)
/models/*.gguf
# the whole plugin: its .gdextension without the binary would print load errors on every boot
/addons/nobodywho/
.asset_cache/

