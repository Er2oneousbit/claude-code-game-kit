// generated by tools/shaders/shader_gen.py from tools/shaders/ksl/flash.ksl: edit that, then regenerate
// Hit flash: the sprite mixed toward a flat colour, alpha kept. Tween amount 1 -> 0 on a hit.
shader_type canvas_item;

uniform float u_amount = 0.6;
uniform vec3 u_flash_color = vec3(1.0, 1.0, 1.0);
uniform vec2 u_canvas = vec2(64.0, 64.0);
uniform vec2 u_texel = vec2(0.03125, 0.03125);

vec4 kit_effect(vec2 uv, sampler2D main_tex) {
    vec4 c = texture(main_tex, uv);
    if (c.a < 0.5) { return vec4(0.0); }
    return vec4(mix(c.rgb, u_flash_color, u_amount), c.a);
}

void fragment() {
    COLOR = kit_effect(UV, TEXTURE);
}
