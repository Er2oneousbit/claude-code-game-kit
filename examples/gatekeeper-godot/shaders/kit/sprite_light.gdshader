// generated by tools/shaders/shader_gen.py from tools/shaders/ksl/sprite_light.ksl: edit that, then regenerate
// Normal-mapped sprite lighting: albedo * (ambient + max(dot(n, L), 0) * light_color), L from the pixel to a light at light_pos (canvas pixels) and light_height above the plane. Uses the normal maps Dotwork and PixelLab make.
shader_type canvas_item;

uniform sampler2D kit_aux : filter_nearest, repeat_disable;
uniform vec2 u_light_pos = vec2(16.0, 12.0);
uniform float u_light_height = 24.0;
uniform vec3 u_light_color = vec3(1.0, 0.95, 0.8);
uniform float u_ambient = 0.25;
uniform vec2 u_canvas = vec2(64.0, 64.0);
uniform vec2 u_texel = vec2(0.03125, 0.03125);

vec4 kit_effect(vec2 uv, sampler2D main_tex) {
    vec4 albedo = texture(main_tex, uv);
    if (albedo.a < 0.5) { return vec4(0.0); }
    vec3 n = normalize(texture(kit_aux, uv).rgb * 2.0 - vec3(1.0));
    vec2 frag = uv * u_canvas;
    vec3 l = normalize(vec3(u_light_pos - frag, u_light_height));
    float diff = max(dot(n, l), 0.0);
    return vec4(clamp(albedo.rgb * (vec3(u_ambient) + u_light_color * diff), vec3(0.0), vec3(1.0)), 1.0);
}

void fragment() {
    COLOR = kit_effect(UV, TEXTURE);
}
