// generated by tools/shaders/shader_gen.py from tools/shaders/ksl/outline.ksl: edit that, then regenerate
// Outline: a one-texel ring of outline_color around the sprite's opaque texels (4-neighbours).
shader_type canvas_item;

uniform vec3 u_outline_color = vec3(0.1, 0.05, 0.2);
uniform vec2 u_canvas = vec2(64.0, 64.0);
uniform vec2 u_texel = vec2(0.03125, 0.03125);

vec4 kit_effect(vec2 uv, sampler2D main_tex) {
    vec4 c = texture(main_tex, uv);
    if (c.a >= 0.5) { return c; }
    float right = texture(main_tex, uv + vec2(u_texel.x, 0.0)).a * step(uv.x + u_texel.x, 1.0);
    float left = texture(main_tex, uv - vec2(u_texel.x, 0.0)).a * step(0.0, uv.x - u_texel.x);
    float down = texture(main_tex, uv + vec2(0.0, u_texel.y)).a * step(uv.y + u_texel.y, 1.0);
    float up = texture(main_tex, uv - vec2(0.0, u_texel.y)).a * step(0.0, uv.y - u_texel.y);
    if (max(max(right, left), max(down, up)) >= 0.5) { return vec4(u_outline_color, 1.0); }
    return vec4(0.0);
}

void fragment() {
    COLOR = kit_effect(UV, TEXTURE);
}
