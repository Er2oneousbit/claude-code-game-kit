import bevy_sprite_render::mesh2d::vertex_output::VertexOutput;

// generated by tools/shaders/shader_gen.py from tools/shaders/ksl/colorblind.ksl: edit that, then regenerate
// Colour-blind filter (daltonization, LMS matrices of Fidaner, Lin and Ozguven): mode 1 protanopia, 2 deuteranopia, 3 tritanopia. The Godot shell's ColorFilter math.

struct KitParams {
    mode: f32,
    canvas: vec2<f32>,
    texel: vec2<f32>,
}

@group(constants::MATERIAL_BIND_GROUP) @binding(0) var<uniform> params: KitParams;
@group(constants::MATERIAL_BIND_GROUP) @binding(1) var main_tex: texture_2d<f32>;
@group(constants::MATERIAL_BIND_GROUP) @binding(2) var main_samp: sampler;
fn SAMPLE_MAIN(p: vec2<f32>) -> vec4<f32> { return textureSampleLevel(main_tex, main_samp, p, 0.0); }

fn kit_effect(uv: vec2<f32>) -> vec4<f32> {
    var c: vec3<f32> = SAMPLE_MAIN(uv).rgb;
    var l: f32 = dot(vec3<f32>(17.8824, 43.5161, 4.11935), c);
    var m: f32 = dot(vec3<f32>(3.45565, 27.1554, 3.86714), c);
    var s: f32 = dot(vec3<f32>(0.0299566, 0.184309, 1.46709), c);
    var sl: f32 = l;
    var sm: f32 = m;
    var ss: f32 = s;
    if (params.mode > 0.5) {
        if (params.mode < 1.5) { sl = 2.02344 * m - 2.52581 * s; } else {
            if (params.mode < 2.5) { sm = 0.494207 * l + 1.24827 * s; } else { ss = -0.395913 * l + 0.801109 * m; }
        }
    }
    var sim: vec3<f32> = vec3<f32>(sl, sm, ss);
    var back: vec3<f32> = vec3<f32>(dot(vec3<f32>(0.0809444479, -0.130504409, 0.116721066), sim), dot(vec3<f32>(-0.0102485335, 0.0540193266, -0.113614708), sim), dot(vec3<f32>(-0.000365296938, -0.00412161469, 0.693511405), sim));
    var err: vec3<f32> = c - back;
    var shift: vec3<f32> = vec3<f32>(0.0, 0.7 * err.r + err.g, 0.7 * err.r + err.b);
    return vec4<f32>(clamp(c + shift, vec3<f32>(0.0), vec3<f32>(1.0)), 1.0);
}

@fragment
fn fragment(in: VertexOutput) -> @location(0) vec4<f32> {
    return kit_effect(in.uv);
}
