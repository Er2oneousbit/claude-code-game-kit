import bevy_sprite_render::mesh2d::vertex_output::VertexOutput;

// generated by tools/shaders/shader_gen.py from tools/shaders/ksl/outline.ksl: edit that, then regenerate
// Outline: a one-texel ring of outline_color around the sprite's opaque texels (4-neighbours).

struct KitParams {
    outline_color: vec3<f32>,
    canvas: vec2<f32>,
    texel: vec2<f32>,
}

@group(constants::MATERIAL_BIND_GROUP) @binding(0) var<uniform> params: KitParams;
@group(constants::MATERIAL_BIND_GROUP) @binding(1) var main_tex: texture_2d<f32>;
@group(constants::MATERIAL_BIND_GROUP) @binding(2) var main_samp: sampler;
fn SAMPLE_MAIN(p: vec2<f32>) -> vec4<f32> { return textureSampleLevel(main_tex, main_samp, p, 0.0); }

fn kit_effect(uv: vec2<f32>) -> vec4<f32> {
    var c: vec4<f32> = SAMPLE_MAIN(uv);
    if (c.a >= 0.5) { return c; }
    var right: f32 = SAMPLE_MAIN(uv + vec2<f32>(params.texel.x, 0.0)).a * step(uv.x + params.texel.x, 1.0);
    var left: f32 = SAMPLE_MAIN(uv - vec2<f32>(params.texel.x, 0.0)).a * step(0.0, uv.x - params.texel.x);
    var down: f32 = SAMPLE_MAIN(uv + vec2<f32>(0.0, params.texel.y)).a * step(uv.y + params.texel.y, 1.0);
    var up: f32 = SAMPLE_MAIN(uv - vec2<f32>(0.0, params.texel.y)).a * step(0.0, uv.y - params.texel.y);
    if (max(max(right, left), max(down, up)) >= 0.5) { return vec4<f32>(params.outline_color, 1.0); }
    return vec4<f32>(0.0);
}

@fragment
fn fragment(in: VertexOutput) -> @location(0) vec4<f32> {
    return kit_effect(in.uv);
}
