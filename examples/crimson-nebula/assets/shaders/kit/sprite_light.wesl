import bevy_sprite_render::mesh2d::vertex_output::VertexOutput;

// generated by tools/shaders/shader_gen.py from tools/shaders/ksl/sprite_light.ksl: edit that, then regenerate
// Normal-mapped sprite lighting: albedo * (ambient + max(dot(n, L), 0) * light_color), L from the pixel to a light at light_pos (canvas pixels) and light_height above the plane. Uses the normal maps Dotwork and PixelLab make.

struct KitParams {
    light_pos: vec2<f32>,
    light_height: f32,
    light_color: vec3<f32>,
    ambient: f32,
    canvas: vec2<f32>,
    texel: vec2<f32>,
}

@group(constants::MATERIAL_BIND_GROUP) @binding(0) var<uniform> params: KitParams;
@group(constants::MATERIAL_BIND_GROUP) @binding(1) var main_tex: texture_2d<f32>;
@group(constants::MATERIAL_BIND_GROUP) @binding(2) var main_samp: sampler;
@group(constants::MATERIAL_BIND_GROUP) @binding(3) var aux_tex: texture_2d<f32>;
@group(constants::MATERIAL_BIND_GROUP) @binding(4) var aux_samp: sampler;
fn SAMPLE_AUX(p: vec2<f32>) -> vec4<f32> { return textureSampleLevel(aux_tex, aux_samp, p, 0.0); }
fn SAMPLE_MAIN(p: vec2<f32>) -> vec4<f32> { return textureSampleLevel(main_tex, main_samp, p, 0.0); }

fn kit_effect(uv: vec2<f32>) -> vec4<f32> {
    var albedo: vec4<f32> = SAMPLE_MAIN(uv);
    if (albedo.a < 0.5) { return vec4<f32>(0.0); }
    var n: vec3<f32> = normalize(SAMPLE_AUX(uv).rgb * 2.0 - vec3<f32>(1.0));
    var frag: vec2<f32> = uv * params.canvas;
    var l: vec3<f32> = normalize(vec3<f32>(params.light_pos - frag, params.light_height));
    var diff: f32 = max(dot(n, l), 0.0);
    return vec4<f32>(clamp(albedo.rgb * (vec3<f32>(params.ambient) + params.light_color * diff), vec3<f32>(0.0), vec3<f32>(1.0)), 1.0);
}

@fragment
fn fragment(in: VertexOutput) -> @location(0) vec4<f32> {
    return kit_effect(in.uv);
}
