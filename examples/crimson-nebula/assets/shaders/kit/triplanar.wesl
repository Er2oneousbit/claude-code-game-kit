import bevy_sprite_render::mesh2d::vertex_output::VertexOutput;

// generated by tools/shaders/shader_gen.py from tools/shaders/ksl/triplanar.ksl: edit that, then regenerate
// Triplanar mapping (for generated models with poor UVs): the tile projected along x, y and z, blended by |normal|^4. Checked on a unit sphere; the 3D port uses world position and normal.

struct KitParams {
    scale: f32,
    sharpness: f32,
    canvas: vec2<f32>,
    texel: vec2<f32>,
}

@group(constants::MATERIAL_BIND_GROUP) @binding(0) var<uniform> params: KitParams;
@group(constants::MATERIAL_BIND_GROUP) @binding(1) var main_tex: texture_2d<f32>;
@group(constants::MATERIAL_BIND_GROUP) @binding(2) var main_samp: sampler;
@group(constants::MATERIAL_BIND_GROUP) @binding(3) var aux_tex: texture_2d<f32>;
@group(constants::MATERIAL_BIND_GROUP) @binding(4) var aux_samp: sampler;
fn SAMPLE_AUX(p: vec2<f32>) -> vec4<f32> { return textureSampleLevel(aux_tex, aux_samp, p, 0.0); }
fn SAMPLE_MAIN(p: vec2<f32>) -> vec4<f32> { return textureSampleLevel(main_tex, main_samp, p, 0.0); }

fn kit_effect(uv: vec2<f32>) -> vec4<f32> {
    var s: vec4<f32> = SAMPLE_MAIN(uv);
    if (s.a < 0.5) { return vec4<f32>(0.0); }
    var n: vec3<f32> = normalize(s.rgb * 2.0 - vec3<f32>(1.0));
    var q: vec2<f32> = uv * 2.0 - vec2<f32>(1.0);
    var pz: f32 = sqrt(max(0.0, 1.0 - dot(q, q)));
    var w: vec3<f32> = pow(abs(n), vec3<f32>(params.sharpness));
    w = w / (w.x + w.y + w.z);
    var tx: vec3<f32> = SAMPLE_AUX(fract(vec2<f32>(q.y, pz) * params.scale)).rgb;
    var ty: vec3<f32> = SAMPLE_AUX(fract(vec2<f32>(q.x, pz) * params.scale)).rgb;
    var tz: vec3<f32> = SAMPLE_AUX(fract(q * params.scale)).rgb;
    return vec4<f32>(clamp(w.x * tx + w.y * ty + w.z * tz, vec3<f32>(0.0), vec3<f32>(1.0)), 1.0);
}

@fragment
fn fragment(in: VertexOutput) -> @location(0) vec4<f32> {
    return kit_effect(in.uv);
}
