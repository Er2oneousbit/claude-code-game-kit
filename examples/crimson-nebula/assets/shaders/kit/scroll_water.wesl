import bevy_sprite_render::mesh2d::vertex_output::VertexOutput;

// generated by tools/shaders/shader_gen.py from tools/shaders/ksl/scroll_water.ksl: edit that, then regenerate
// Scrolling, wavy texture (water, clouds, lava): the tile repeated twice, shifted by time * speed and bent by a sine wave. Checked at time = 0.27.

struct KitParams {
    time: f32,
    speed: vec2<f32>,
    amplitude: f32,
    frequency: f32,
    canvas: vec2<f32>,
    texel: vec2<f32>,
}

@group(constants::MATERIAL_BIND_GROUP) @binding(0) var<uniform> params: KitParams;
@group(constants::MATERIAL_BIND_GROUP) @binding(1) var main_tex: texture_2d<f32>;
@group(constants::MATERIAL_BIND_GROUP) @binding(2) var main_samp: sampler;
fn SAMPLE_MAIN(p: vec2<f32>) -> vec4<f32> { return textureSampleLevel(main_tex, main_samp, p, 0.0); }

fn kit_effect(uv: vec2<f32>) -> vec4<f32> {
    var u: f32 = uv.x * 2.0 + params.time * params.speed.x;
    var v: f32 = uv.y * 2.0 + params.time * params.speed.y + params.amplitude * sin(6.2831853 * (uv.x * params.frequency + params.time));
    return vec4<f32>(SAMPLE_MAIN(fract(vec2<f32>(u, v))).rgb, 1.0);
}

@fragment
fn fragment(in: VertexOutput) -> @location(0) vec4<f32> {
    return kit_effect(in.uv);
}
