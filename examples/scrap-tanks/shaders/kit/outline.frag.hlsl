// generated by tools/shaders/shader_gen.py from tools/shaders/ksl/outline.ksl: edit that, then regenerate
// Outline: a one-texel ring of outline_color around the sprite's opaque texels (4-neighbours).
Texture2D<float4> MainTex : register(t0, space2);
SamplerState MainSampler : register(s0, space2);
cbuffer KitParams : register(b0, space3)
{
    float4 kit_p0;
    float4 kit_p1;
    float4 kit_p2;
};
#define u_outline_color kit_p0.xyz
#define u_canvas kit_p1.xy
#define u_texel kit_p2.xy
float4 SAMPLE_MAIN(float2 p) { return MainTex.SampleLevel(MainSampler, p, 0); }

float4 kit_effect(float2 uv)
{
    float4 c = SAMPLE_MAIN(uv);
    if (c.a >= 0.5) { return c; }
    float right = SAMPLE_MAIN(uv + float2(u_texel.x, 0.0)).a * step(uv.x + u_texel.x, 1.0);
    float left = SAMPLE_MAIN(uv - float2(u_texel.x, 0.0)).a * step(0.0, uv.x - u_texel.x);
    float down = SAMPLE_MAIN(uv + float2(0.0, u_texel.y)).a * step(uv.y + u_texel.y, 1.0);
    float up = SAMPLE_MAIN(uv - float2(0.0, u_texel.y)).a * step(0.0, uv.y - u_texel.y);
    if (max(max(right, left), max(down, up)) >= 0.5) { return float4(u_outline_color, 1.0); }
    return ((float4)(0.0));
}

struct PSInput {
    float4 v_color : COLOR0;
    float2 v_uv : TEXCOORD0;
};

float4 main(PSInput input) : SV_Target0
{
    return kit_effect(input.v_uv) * input.v_color;   // SDL_SetTextureColorMod tints it
}
