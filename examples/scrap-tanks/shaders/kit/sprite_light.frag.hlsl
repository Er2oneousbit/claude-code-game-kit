// generated by tools/shaders/shader_gen.py from tools/shaders/ksl/sprite_light.ksl: edit that, then regenerate
// Normal-mapped sprite lighting: albedo * (ambient + max(dot(n, L), 0) * light_color), L from the pixel to a light at light_pos (canvas pixels) and light_height above the plane. Uses the normal maps Dotwork and PixelLab make.
Texture2D<float4> MainTex : register(t0, space2);
SamplerState MainSampler : register(s0, space2);
Texture2D<float4> AuxTex : register(t1, space2);
SamplerState AuxSampler : register(s1, space2);
float4 SAMPLE_AUX(float2 p) { return AuxTex.SampleLevel(AuxSampler, p, 0); }
cbuffer KitParams : register(b0, space3)
{
    float4 kit_p0;
    float4 kit_p1;
    float4 kit_p2;
    float4 kit_p3;
    float4 kit_p4;
    float4 kit_p5;
};
#define u_light_pos kit_p0.xy
#define u_light_height kit_p1.x
#define u_light_color kit_p2.xyz
#define u_ambient kit_p3.x
#define u_canvas kit_p4.xy
#define u_texel kit_p5.xy
float4 SAMPLE_MAIN(float2 p) { return MainTex.SampleLevel(MainSampler, p, 0); }

float4 kit_effect(float2 uv)
{
    float4 albedo = SAMPLE_MAIN(uv);
    if (albedo.a < 0.5) { return ((float4)(0.0)); }
    float3 n = normalize(SAMPLE_AUX(uv).rgb * 2.0 - ((float3)(1.0)));
    float2 frag = uv * u_canvas;
    float3 l = normalize(float3(u_light_pos - frag, u_light_height));
    float diff = max(dot(n, l), 0.0);
    return float4(clamp(albedo.rgb * (((float3)(u_ambient)) + u_light_color * diff), ((float3)(0.0)), ((float3)(1.0))), 1.0);
}

struct PSInput {
    float4 v_color : COLOR0;
    float2 v_uv : TEXCOORD0;
};

float4 main(PSInput input) : SV_Target0
{
    return kit_effect(input.v_uv) * input.v_color;   // SDL_SetTextureColorMod tints it
}
