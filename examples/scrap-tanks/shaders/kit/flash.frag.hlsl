// generated by tools/shaders/shader_gen.py from tools/shaders/ksl/flash.ksl: edit that, then regenerate
// Hit flash: the sprite mixed toward a flat colour, alpha kept. Tween amount 1 -> 0 on a hit.
Texture2D<float4> MainTex : register(t0, space2);
SamplerState MainSampler : register(s0, space2);
cbuffer KitParams : register(b0, space3)
{
    float4 kit_p0;
    float4 kit_p1;
    float4 kit_p2;
    float4 kit_p3;
};
#define u_amount kit_p0.x
#define u_flash_color kit_p1.xyz
#define u_canvas kit_p2.xy
#define u_texel kit_p3.xy
float4 SAMPLE_MAIN(float2 p) { return MainTex.SampleLevel(MainSampler, p, 0); }

float4 kit_effect(float2 uv)
{
    float4 c = SAMPLE_MAIN(uv);
    if (c.a < 0.5) { return ((float4)(0.0)); }
    return float4(lerp(c.rgb, u_flash_color, u_amount), c.a);
}

struct PSInput {
    float4 v_color : COLOR0;
    float2 v_uv : TEXCOORD0;
};

float4 main(PSInput input) : SV_Target0
{
    return kit_effect(input.v_uv) * input.v_color;   // SDL_SetTextureColorMod tints it
}
