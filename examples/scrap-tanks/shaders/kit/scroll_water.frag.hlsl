// generated by tools/shaders/shader_gen.py from tools/shaders/ksl/scroll_water.ksl: edit that, then regenerate
// Scrolling, wavy texture (water, clouds, lava): the tile repeated twice, shifted by time * speed and bent by a sine wave. Checked at time = 0.27.
Texture2D<float4> MainTex : register(t0, space2);
SamplerState MainSampler : register(s0, space2);
cbuffer KitParams : register(b0, space3)
{
    float4 kit_p0;
    float4 kit_p1;
    float4 kit_p2;
    float4 kit_p3;
    float4 kit_p4;
    float4 kit_p5;
};
#define u_time kit_p0.x
#define u_speed kit_p1.xy
#define u_amplitude kit_p2.x
#define u_frequency kit_p3.x
#define u_canvas kit_p4.xy
#define u_texel kit_p5.xy
float4 SAMPLE_MAIN(float2 p) { return MainTex.SampleLevel(MainSampler, p, 0); }

float4 kit_effect(float2 uv)
{
    float u = uv.x * 2.0 + u_time * u_speed.x;
    float v = uv.y * 2.0 + u_time * u_speed.y + u_amplitude * sin(6.2831853 * (uv.x * u_frequency + u_time));
    return float4(SAMPLE_MAIN(frac(float2(u, v))).rgb, 1.0);
}

struct PSInput {
    float4 v_color : COLOR0;
    float2 v_uv : TEXCOORD0;
};

float4 main(PSInput input) : SV_Target0
{
    return kit_effect(input.v_uv) * input.v_color;   // SDL_SetTextureColorMod tints it
}
