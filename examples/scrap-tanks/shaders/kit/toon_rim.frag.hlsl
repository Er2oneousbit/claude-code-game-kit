// generated by tools/shaders/shader_gen.py from tools/shaders/ksl/toon_rim.ksl: edit that, then regenerate
// Toon shading with a rim light, from a normal (n.z toward the viewer): three light bands from dot(n, light_dir) plus rim = smoothstep(0.55, 0.75, 1 - n.z) * rim_strength. Checked on a sphere's normal map; the 3D port uses the same function on the surface normal.
Texture2D<float4> MainTex : register(t0, space2);
SamplerState MainSampler : register(s0, space2);
cbuffer KitParams : register(b0, space3)
{
    float4 kit_p0;
    float4 kit_p1;
    float4 kit_p2;
    float4 kit_p3;
    float4 kit_p4;
};
#define u_albedo kit_p0.xyz
#define u_light_dir kit_p1.xyz
#define u_rim_strength kit_p2.x
#define u_canvas kit_p3.xy
#define u_texel kit_p4.xy
float4 SAMPLE_MAIN(float2 p) { return MainTex.SampleLevel(MainSampler, p, 0); }

float4 kit_effect(float2 uv)
{
    float4 s = SAMPLE_MAIN(uv);
    if (s.a < 0.5) { return ((float4)(0.0)); }
    float3 n = normalize(s.rgb * 2.0 - ((float3)(1.0)));
    float ndl = dot(n, normalize(u_light_dir));
    float band = 0.3;
    if (ndl > 0.0) { band = 0.6; }
    if (ndl > 0.5) { band = 1.0; }
    float rim = smoothstep(0.55, 0.75, 1.0 - n.z) * u_rim_strength;
    return float4(clamp(u_albedo * band + ((float3)(rim)), ((float3)(0.0)), ((float3)(1.0))), 1.0);
}

struct PSInput {
    float4 v_color : COLOR0;
    float2 v_uv : TEXCOORD0;
};

float4 main(PSInput input) : SV_Target0
{
    return kit_effect(input.v_uv) * input.v_color;   // SDL_SetTextureColorMod tints it
}
