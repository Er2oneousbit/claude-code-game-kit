// generated by tools/shaders/shader_gen.py from tools/shaders/ksl/crt.ksl: edit that, then regenerate
// CRT scanlines: every second row (counted from the top) darkened by scanline.
Texture2D<float4> MainTex : register(t0, space2);
SamplerState MainSampler : register(s0, space2);
cbuffer KitParams : register(b0, space3)
{
    float4 kit_p0;
    float4 kit_p1;
    float4 kit_p2;
};
#define u_scanline kit_p0.x
#define u_canvas kit_p1.xy
#define u_texel kit_p2.xy
float4 SAMPLE_MAIN(float2 p) { return MainTex.SampleLevel(MainSampler, p, 0); }

float4 kit_effect(float2 uv)
{
    float4 c = SAMPLE_MAIN(uv);
    float row = floor(uv.y * u_canvas.y);
    float odd = row - 2.0 * floor(row / 2.0);
    return float4(c.rgb * (1.0 - u_scanline * odd), 1.0);
}

struct PSInput {
    float4 v_color : COLOR0;
    float2 v_uv : TEXCOORD0;
};

float4 main(PSInput input) : SV_Target0
{
    return kit_effect(input.v_uv) * input.v_color;   // SDL_SetTextureColorMod tints it
}
