{
  "1": {"class_type": "LoadImage", "_meta": {"title": "INPUT image"},
        "inputs": {"image": "reference.png"}},
  "2": {"class_type": "ImageScaleToTotalPixels", "_meta": {"title": "Scale to 1 MP"},
        "inputs": {"image": ["1", 0], "upscale_method": "lanczos", "megapixels": 1.0, "resolution_steps": 16}},
  "3": {"class_type": "UnetLoaderGGUF", "_meta": {"title": "Qwen-Image-Edit-2511"},
        "inputs": {"unet_name": "qwen-image-edit-2511-Q4_K_M.gguf"}},
  "4": {"class_type": "LoraLoaderModelOnly", "_meta": {"title": "Angle LoRA"},
        "inputs": {"model": ["3", 0], "lora_name": "qwen-image-edit-2511-multiple-angles-lora.safetensors",
                   "strength_model": 0.9}},
  "5": {"class_type": "ModelSamplingAuraFlow", "_meta": {"title": "Shift"},
        "inputs": {"model": ["4", 0], "shift": 3.1}},
  "6": {"class_type": "CFGNorm", "_meta": {"title": "CFG norm"},
        "inputs": {"model": ["5", 0], "strength": 1.0}},
  "7": {"class_type": "LoraLoaderModelOnly", "_meta": {"title": "Lightning LoRA"},
        "inputs": {"model": ["6", 0], "lora_name": "Qwen-Image-Edit-2511-Lightning-4steps-V1.0-bf16.safetensors",
                   "strength_model": 1.0}},
  "8": {"class_type": "CLIPLoader", "_meta": {"title": "Qwen2.5-VL 7B text encoder"},
        "inputs": {"clip_name": "qwen_2.5_vl_7b.safetensors", "type": "qwen_image", "device": "default"}},
  "9": {"class_type": "VAELoader", "_meta": {"title": "Qwen-Image VAE"},
        "inputs": {"vae_name": "qwen_image_vae.safetensors"}},
  "10": {"class_type": "TextEncodeQwenImageEditPlus", "_meta": {"title": "Edit prompt"},
         "inputs": {"clip": ["8", 0], "prompt": "<sks> left side view eye-level shot medium shot", "vae": ["9", 0],
                    "image1": ["2", 0]}},
  "11": {"class_type": "TextEncodeQwenImageEditPlus", "_meta": {"title": "Negative"},
         "inputs": {"clip": ["8", 0], "prompt": "", "vae": ["9", 0], "image1": ["2", 0]}},
  "12": {"class_type": "FluxKontextMultiReferenceLatentMethod", "_meta": {"title": "Reference method +"},
         "inputs": {"conditioning": ["10", 0], "reference_latents_method": "index_timestep_zero"}},
  "13": {"class_type": "FluxKontextMultiReferenceLatentMethod", "_meta": {"title": "Reference method -"},
         "inputs": {"conditioning": ["11", 0], "reference_latents_method": "index_timestep_zero"}},
  "14": {"class_type": "VAEEncode", "_meta": {"title": "Latent from the input"},
         "inputs": {"pixels": ["2", 0], "vae": ["9", 0]}},
  "15": {"class_type": "KSampler", "_meta": {"title": "SEED"},
         "inputs": {"model": ["7", 0], "seed": 1, "steps": 4, "cfg": 1.0, "sampler_name": "euler",
                    "scheduler": "simple", "positive": ["12", 0], "negative": ["13", 0], "latent_image": ["14", 0],
                    "denoise": 1.0}},
  "16": {"class_type": "VAEDecode", "_meta": {"title": "Decode"},
         "inputs": {"samples": ["15", 0], "vae": ["9", 0]}},
  "17": {"class_type": "SaveImage", "_meta": {"title": "OUTPUT view"},
         "inputs": {"images": ["16", 0], "filename_prefix": "bozzetto/reference_view"}}
}
