// generated by tools/shaders/shader_gen.py from tools/shaders/ksl/crt.ksl: edit that, then regenerate
// CRT scanlines: every second row (counted from the top) darkened by scanline.
shader_type canvas_item;

uniform sampler2D kit_screen : hint_screen_texture, filter_nearest;
uniform float u_scanline = 0.35;
uniform vec2 u_canvas = vec2(64.0, 64.0);
uniform vec2 u_texel = vec2(0.03125, 0.03125);

vec4 kit_effect(vec2 uv, sampler2D main_tex) {
    vec4 c = texture(main_tex, uv);
    float row = floor(uv.y * u_canvas.y);
    float odd = row - 2.0 * floor(row / 2.0);
    return vec4(c.rgb * (1.0 - u_scanline * odd), 1.0);
}

void fragment() {
    COLOR = kit_effect(SCREEN_UV, kit_screen);
}
