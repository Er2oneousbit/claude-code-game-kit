// generated by tools/shaders/shader_gen.py from tools/shaders/ksl/palette_swap.ksl: edit that, then regenerate
// Palette swap: an indexed sprite (index = red channel / 16) coloured from a 16 x 1 palette texture; swap the palette for team colours or damage states.
shader_type canvas_item;

uniform sampler2D kit_aux : filter_nearest, repeat_disable;
uniform vec2 u_canvas = vec2(64.0, 64.0);
uniform vec2 u_texel = vec2(0.03125, 0.03125);

vec4 kit_effect(vec2 uv, sampler2D main_tex) {
    vec4 c = texture(main_tex, uv);
    if (c.a < 0.5) { return vec4(0.0); }
    float index = floor(c.r * 255.0 / 16.0 + 0.5);
    return vec4(texture(kit_aux, vec2((index + 0.5) / 16.0, 0.5)).rgb, 1.0);
}

void fragment() {
    COLOR = kit_effect(UV, TEXTURE);
}
