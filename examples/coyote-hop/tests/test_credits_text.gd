# ---------------------------------------------------------------------------
# test_credits_text.gd
# Purpose : The credits screen's text (CreditsScreen.plain_text): HTML comments out of CREDITS.md (#279; every case
#           in data/golden/credits.json) and the rest of its markdown handling on a file as tools/credits.py writes it.
# Usage   : python tools/dev.py test      (or --filter test_credits_text.gd)
# Notes   : A case type this file does not know fails test_every_case_type_is_known. Expected values are only ever
#           read from the JSON (tools/golden_vectors.py writes it).
# Authored: Written with Claude (Opus 5.5, claude-opus-5-5)
# ---------------------------------------------------------------------------
extends GutTest

const Golden = preload("res://tests/golden_util.gd")
const FILE: String = "credits.json"
const KNOWN_TYPES: PackedStringArray = ["strip_comments"]

var _file: Dictionary = {}


func before_all() -> void:
	_file = Golden.load_file(FILE)


func test_file_loaded() -> void:
	assert_false(_file.is_empty(), "res://data/golden/%s is missing or not JSON (it ships from the kit)" % FILE)


func test_every_case_type_is_known() -> void:
	for c: Dictionary in _file.get("cases", []):
		assert_true(KNOWN_TYPES.has(c["type"]), "unknown case type '%s' (%s): port it, then add it here" % [c["type"], c["name"]])


func test_strip_comments() -> void:
	var n: int = 0
	for c: Dictionary in _file.get("cases", []):
		if c["type"] != "strip_comments":
			continue
		for p: Array in c["points"]:
			assert_eq(CreditsScreen.strip_html_comments(str(p[1])), str(p[2]), "%s: %s" % [c["name"], p[0]])
			n += 1
	assert_gt(n, 0, "no strip_comments points in %s" % FILE)
	gut.p("[golden] %s strip_comments: %d point(s) checked" % [FILE, n])


func test_a_credits_md_from_credits_py_shows_no_comment() -> void:
	var md: String = "# Credits\r\n\r\n<!-- Generated by tools/credits.py from docs/ASSET_LOG.md: edit the asset log, " \
			+ "not this file. -->\r\n\r\n## Music\r\n\r\n<!--\r\nnotes\r\n-->\r\n- Song by Zoë (CC0)\r\n"
	var got: String = CreditsScreen.plain_text(md)
	assert_false(got.contains("<!--") or got.contains("Generated by") or got.contains("notes"), got)
	assert_eq(got, "Credits\n\nMusic\n\n- Song by Zoë (CC0)")


func test_a_file_with_only_a_comment_is_empty() -> void:
	assert_eq(CreditsScreen.plain_text("<!-- nothing yet -->\n"), "", "the screen shows its placeholder then")
