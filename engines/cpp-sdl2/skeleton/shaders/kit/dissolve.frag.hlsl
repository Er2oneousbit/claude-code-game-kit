// generated by tools/shaders/shader_gen.py from tools/shaders/ksl/dissolve.ksl: edit that, then regenerate
// Dissolve: texels whose noise is under progress vanish, a band of edge_color above them. Tween progress 0 -> 1 for a defeat.
Texture2D<float4> MainTex : register(t0, space2);
SamplerState MainSampler : register(s0, space2);
Texture2D<float4> AuxTex : register(t1, space2);
SamplerState AuxSampler : register(s1, space2);
float4 SAMPLE_AUX(float2 p) { return AuxTex.SampleLevel(AuxSampler, p, 0); }
cbuffer KitParams : register(b0, space3)
{
    float4 kit_p0;
    float4 kit_p1;
    float4 kit_p2;
    float4 kit_p3;
    float4 kit_p4;
};
#define u_progress kit_p0.x
#define u_edge_width kit_p1.x
#define u_edge_color kit_p2.xyz
#define u_canvas kit_p3.xy
#define u_texel kit_p4.xy
float4 SAMPLE_MAIN(float2 p) { return MainTex.SampleLevel(MainSampler, p, 0); }

float4 kit_effect(float2 uv)
{
    float4 c = SAMPLE_MAIN(uv);
    if (c.a < 0.5) { return ((float4)(0.0)); }
    float n = SAMPLE_AUX(uv).r;
    if (n < u_progress) { return ((float4)(0.0)); }
    if (n < u_progress + u_edge_width) { return float4(u_edge_color, c.a); }
    return c;
}

struct PSInput {
    float4 v_color : COLOR0;
    float2 v_uv : TEXCOORD0;
};

float4 main(PSInput input) : SV_Target0
{
    return kit_effect(input.v_uv) * input.v_color;   // SDL_SetTextureColorMod tints it
}
