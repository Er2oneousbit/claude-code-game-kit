// generated by tools/shaders/shader_gen.py from tools/shaders/ksl/flash.ksl: edit that, then regenerate
// Hit flash: the sprite mixed toward a flat colour, alpha kept. Tween amount 1 -> 0 on a hit.
uniform float u_amount;
uniform vec3 u_flash_color;
uniform vec2 u_canvas;
uniform vec2 u_texel;

vec4 kit_effect(vec2 uv, Image main_tex) {
    vec4 c = Texel(main_tex, uv);
    if (c.a < 0.5) { return vec4(0.0); }
    return vec4(mix(c.rgb, u_flash_color, u_amount), c.a);
}

vec4 effect(vec4 color, Image tex, vec2 tc, vec2 sc) {
    return kit_effect(tc, tex) * color;   // love.graphics.setColor tints it, as for any LOVE sprite
}
