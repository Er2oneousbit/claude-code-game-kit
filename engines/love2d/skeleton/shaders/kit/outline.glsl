// generated by tools/shaders/shader_gen.py from tools/shaders/ksl/outline.ksl: edit that, then regenerate
// Outline: a one-texel ring of outline_color around the sprite's opaque texels (4-neighbours).
uniform vec3 u_outline_color;
uniform vec2 u_canvas;
uniform vec2 u_texel;

vec4 kit_effect(vec2 uv, Image main_tex) {
    vec4 c = Texel(main_tex, uv);
    if (c.a >= 0.5) { return c; }
    float right = Texel(main_tex, uv + vec2(u_texel.x, 0.0)).a * step(uv.x + u_texel.x, 1.0);
    float left = Texel(main_tex, uv - vec2(u_texel.x, 0.0)).a * step(0.0, uv.x - u_texel.x);
    float down = Texel(main_tex, uv + vec2(0.0, u_texel.y)).a * step(uv.y + u_texel.y, 1.0);
    float up = Texel(main_tex, uv - vec2(0.0, u_texel.y)).a * step(0.0, uv.y - u_texel.y);
    if (max(max(right, left), max(down, up)) >= 0.5) { return vec4(u_outline_color, 1.0); }
    return vec4(0.0);
}

vec4 effect(vec4 color, Image tex, vec2 tc, vec2 sc) {
    return kit_effect(tc, tex) * color;   // love.graphics.setColor tints it, as for any LOVE sprite
}
