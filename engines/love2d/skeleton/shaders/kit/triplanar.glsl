// generated by tools/shaders/shader_gen.py from tools/shaders/ksl/triplanar.ksl: edit that, then regenerate
// Triplanar mapping (for generated models with poor UVs): the tile projected along x, y and z, blended by |normal|^4. Checked on a unit sphere; the 3D port uses world position and normal.
uniform Image kit_aux;
uniform float u_scale;
uniform float u_sharpness;
uniform vec2 u_canvas;
uniform vec2 u_texel;

vec4 kit_effect(vec2 uv, Image main_tex) {
    vec4 s = Texel(main_tex, uv);
    if (s.a < 0.5) { return vec4(0.0); }
    vec3 n = normalize(s.rgb * 2.0 - vec3(1.0));
    vec2 q = uv * 2.0 - vec2(1.0);
    float pz = sqrt(max(0.0, 1.0 - dot(q, q)));
    vec3 w = pow(abs(n), vec3(u_sharpness));
    w = w / (w.x + w.y + w.z);
    vec3 tx = Texel(kit_aux, fract(vec2(q.y, pz) * u_scale)).rgb;
    vec3 ty = Texel(kit_aux, fract(vec2(q.x, pz) * u_scale)).rgb;
    vec3 tz = Texel(kit_aux, fract(q * u_scale)).rgb;
    return vec4(clamp(w.x * tx + w.y * ty + w.z * tz, vec3(0.0), vec3(1.0)), 1.0);
}

vec4 effect(vec4 color, Image tex, vec2 tc, vec2 sc) {
    return kit_effect(tc, tex) * color;   // love.graphics.setColor tints it, as for any LOVE sprite
}
