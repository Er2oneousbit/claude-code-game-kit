// generated by tools/shaders/shader_gen.py from tools/shaders/ksl/dissolve.ksl: edit that, then regenerate
// Dissolve: texels whose noise is under progress vanish, a band of edge_color above them. Tween progress 0 -> 1 for a defeat.
uniform Image kit_aux;
uniform float u_progress;
uniform float u_edge_width;
uniform vec3 u_edge_color;
uniform vec2 u_canvas;
uniform vec2 u_texel;

vec4 kit_effect(vec2 uv, Image main_tex) {
    vec4 c = Texel(main_tex, uv);
    if (c.a < 0.5) { return vec4(0.0); }
    float n = Texel(kit_aux, uv).r;
    if (n < u_progress) { return vec4(0.0); }
    if (n < u_progress + u_edge_width) { return vec4(u_edge_color, c.a); }
    return c;
}

vec4 effect(vec4 color, Image tex, vec2 tc, vec2 sc) {
    return kit_effect(tc, tex) * color;   // love.graphics.setColor tints it, as for any LOVE sprite
}
