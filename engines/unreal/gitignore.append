# ---- Unreal Engine 5 ----
Binaries/
# The project-root Build/ holds files you DO commit (game icon, PakBlacklist, mobile resources): ignore
# only what UBT generates there. Packaged builds go to /Packaged/ (dev.py package), never Build/.
/Build/*
!/Build/*/
/Build/*/**
!/Build/*/PakBlacklist*.txt
!/Build/**/*.ico
!/Build/**/Resources/
!/Build/**/Resources/**
DerivedDataCache/
Intermediate/
Saved/
.vs/
*.sln
*.suo
*.VC.db
*.opensdf
*.sdf
*.xcworkspace
*.xcodeproj
# VS Code workspace and search config generated by UBT (machine-specific engine paths)
*.code-workspace
/.ignore
# Packaged output (dev.py package)
/Packaged/
# Plugins build output
Plugins/**/Binaries/
Plugins/**/Intermediate/
