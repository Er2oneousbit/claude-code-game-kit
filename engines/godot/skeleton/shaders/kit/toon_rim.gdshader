// generated by tools/shaders/shader_gen.py from tools/shaders/ksl/toon_rim.ksl: edit that, then regenerate
// Toon shading with a rim light, from a normal (n.z toward the viewer): three light bands from dot(n, light_dir) plus rim = smoothstep(0.55, 0.75, 1 - n.z) * rim_strength. Checked on a sphere's normal map; the 3D port uses the same function on the surface normal.
shader_type canvas_item;

uniform vec3 u_albedo = vec3(0.8, 0.3, 0.2);
uniform vec3 u_light_dir = vec3(-0.5, -0.6, 0.62);
uniform float u_rim_strength = 0.4;
uniform vec2 u_canvas = vec2(64.0, 64.0);
uniform vec2 u_texel = vec2(0.03125, 0.03125);

vec4 kit_effect(vec2 uv, sampler2D main_tex) {
    vec4 s = texture(main_tex, uv);
    if (s.a < 0.5) { return vec4(0.0); }
    vec3 n = normalize(s.rgb * 2.0 - vec3(1.0));
    float ndl = dot(n, normalize(u_light_dir));
    float band = 0.3;
    if (ndl > 0.0) { band = 0.6; }
    if (ndl > 0.5) { band = 1.0; }
    float rim = smoothstep(0.55, 0.75, 1.0 - n.z) * u_rim_strength;
    return vec4(clamp(u_albedo * band + vec3(rim), vec3(0.0), vec3(1.0)), 1.0);
}

void fragment() {
    COLOR = kit_effect(UV, TEXTURE);
}
