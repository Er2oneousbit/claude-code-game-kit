// generated by tools/shaders/shader_gen.py from tools/shaders/ksl/dissolve.ksl: edit that, then regenerate
// Dissolve: texels whose noise is under progress vanish, a band of edge_color above them. Tween progress 0 -> 1 for a defeat.
shader_type canvas_item;

uniform sampler2D kit_aux : filter_nearest, repeat_disable;
uniform float u_progress = 0.5;
uniform float u_edge_width = 0.125;
uniform vec3 u_edge_color = vec3(1.0, 0.85, 0.4);
uniform vec2 u_canvas = vec2(64.0, 64.0);
uniform vec2 u_texel = vec2(0.03125, 0.03125);

vec4 kit_effect(vec2 uv, sampler2D main_tex) {
    vec4 c = texture(main_tex, uv);
    if (c.a < 0.5) { return vec4(0.0); }
    float n = texture(kit_aux, uv).r;
    if (n < u_progress) { return vec4(0.0); }
    if (n < u_progress + u_edge_width) { return vec4(u_edge_color, c.a); }
    return c;
}

void fragment() {
    COLOR = kit_effect(UV, TEXTURE);
}
