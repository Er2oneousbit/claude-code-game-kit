// generated by tools/shaders/shader_gen.py from tools/shaders/ksl/vignette.ksl: edit that, then regenerate
// Vignette: darkened toward the corners, smoothstep(radius, 1, distance from the centre / 0.7071) times strength.
shader_type canvas_item;

uniform sampler2D kit_screen : hint_screen_texture, filter_nearest;
uniform float u_strength = 0.6;
uniform float u_radius = 0.4;
uniform vec2 u_canvas = vec2(64.0, 64.0);
uniform vec2 u_texel = vec2(0.03125, 0.03125);

vec4 kit_effect(vec2 uv, sampler2D main_tex) {
    vec4 c = texture(main_tex, uv);
    float d = length(uv - vec2(0.5, 0.5)) / 0.70710678;
    float f = 1.0 - u_strength * smoothstep(u_radius, 1.0, d);
    return vec4(c.rgb * f, 1.0);
}

void fragment() {
    COLOR = kit_effect(SCREEN_UV, kit_screen);
}
