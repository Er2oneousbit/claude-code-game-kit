import bevy_sprite_render::mesh2d::vertex_output::VertexOutput;

// generated by tools/shaders/shader_gen.py from tools/shaders/ksl/dissolve.ksl: edit that, then regenerate
// Dissolve: texels whose noise is under progress vanish, a band of edge_color above them. Tween progress 0 -> 1 for a defeat.

struct KitParams {
    progress: f32,
    edge_width: f32,
    edge_color: vec3<f32>,
    canvas: vec2<f32>,
    texel: vec2<f32>,
}

@group(constants::MATERIAL_BIND_GROUP) @binding(0) var<uniform> params: KitParams;
@group(constants::MATERIAL_BIND_GROUP) @binding(1) var main_tex: texture_2d<f32>;
@group(constants::MATERIAL_BIND_GROUP) @binding(2) var main_samp: sampler;
@group(constants::MATERIAL_BIND_GROUP) @binding(3) var aux_tex: texture_2d<f32>;
@group(constants::MATERIAL_BIND_GROUP) @binding(4) var aux_samp: sampler;
fn SAMPLE_AUX(p: vec2<f32>) -> vec4<f32> { return textureSampleLevel(aux_tex, aux_samp, p, 0.0); }
fn SAMPLE_MAIN(p: vec2<f32>) -> vec4<f32> { return textureSampleLevel(main_tex, main_samp, p, 0.0); }

fn kit_effect(uv: vec2<f32>) -> vec4<f32> {
    var c: vec4<f32> = SAMPLE_MAIN(uv);
    if (c.a < 0.5) { return vec4<f32>(0.0); }
    var n: f32 = SAMPLE_AUX(uv).r;
    if (n < params.progress) { return vec4<f32>(0.0); }
    if (n < params.progress + params.edge_width) { return vec4<f32>(params.edge_color, c.a); }
    return c;
}

@fragment
fn fragment(in: VertexOutput) -> @location(0) vec4<f32> {
    return kit_effect(in.uv);
}
