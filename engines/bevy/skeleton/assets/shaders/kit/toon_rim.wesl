import bevy_sprite_render::mesh2d::vertex_output::VertexOutput;

// generated by tools/shaders/shader_gen.py from tools/shaders/ksl/toon_rim.ksl: edit that, then regenerate
// Toon shading with a rim light, from a normal (n.z toward the viewer): three light bands from dot(n, light_dir) plus rim = smoothstep(0.55, 0.75, 1 - n.z) * rim_strength. Checked on a sphere's normal map; the 3D port uses the same function on the surface normal.

struct KitParams {
    albedo: vec3<f32>,
    light_dir: vec3<f32>,
    rim_strength: f32,
    canvas: vec2<f32>,
    texel: vec2<f32>,
}

@group(constants::MATERIAL_BIND_GROUP) @binding(0) var<uniform> params: KitParams;
@group(constants::MATERIAL_BIND_GROUP) @binding(1) var main_tex: texture_2d<f32>;
@group(constants::MATERIAL_BIND_GROUP) @binding(2) var main_samp: sampler;
fn SAMPLE_MAIN(p: vec2<f32>) -> vec4<f32> { return textureSampleLevel(main_tex, main_samp, p, 0.0); }

fn kit_effect(uv: vec2<f32>) -> vec4<f32> {
    var s: vec4<f32> = SAMPLE_MAIN(uv);
    if (s.a < 0.5) { return vec4<f32>(0.0); }
    var n: vec3<f32> = normalize(s.rgb * 2.0 - vec3<f32>(1.0));
    var ndl: f32 = dot(n, normalize(params.light_dir));
    var band: f32 = 0.3;
    if (ndl > 0.0) { band = 0.6; }
    if (ndl > 0.5) { band = 1.0; }
    var rim: f32 = smoothstep(0.55, 0.75, 1.0 - n.z) * params.rim_strength;
    return vec4<f32>(clamp(params.albedo * band + vec3<f32>(rim), vec3<f32>(0.0), vec3<f32>(1.0)), 1.0);
}

@fragment
fn fragment(in: VertexOutput) -> @location(0) vec4<f32> {
    return kit_effect(in.uv);
}
